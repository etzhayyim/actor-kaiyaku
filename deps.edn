{:paths ["src" "test" "data"]
 ;; kaiyaku 解約 cljc port (ADR-2606112201) on the portable-Clojure agent stack:
 ;;   langchain-clj → langgraph-clj → browser-use-clj / computer-use-clj
 ;; All four are zero-third-party-dep .cljc (WASM premise, Datomic-API-first).
 :deps {cheshire/cheshire {:mvn/version "5.13.0"}
        ;; 契約(継続課金)の正準 item shape。kaiyaku は vault を開けない —
        ;; kagitaba は crypto/store に依存しない純データモデルなので、
        ;; 復号済み item を受け取るための型だけをここから借りる。
        io.github.kotoba-lang/kagitaba
        {:git/url "https://github.com/kotoba-lang/kagitaba.git"
         :git/sha "65209095c74ccae621c623cdd44f9567de68f05b"}
        etzhayyim/tate {:git/url "https://github.com/etzhayyim/com-etzhayyim-tate"
                        :git/sha "658b9f67aaa65d7aad5ffda280ec8feaae7a8bc2"}
        io.github.com-junkawasaki/langgraph-clj
        {:git/tag "v0.2.0" :git/sha "133740f"}
        ;; Root authority over langgraph's older transitive pin. This revision
        ;; supplies the repository EDN persistence host used by deployments.
        io.github.com-junkawasaki/langchain-clj
        {:git/url "https://github.com/kotoba-lang/langchain.git"
         :git/sha "7038bb80ce030cc5a279785512c0e92d09f323e0"}
        io.github.com-junkawasaki/browser-use-clj
        {:git/tag "v0.1.0" :git/sha "119cd2f"}
        io.github.com-junkawasaki/computer-use-clj
        {:git/tag "v0.1.0" :git/sha "75b777a"}}
 :aliases
 {:repository {:main-opts ["-m" "kaiyaku.repository-runtime"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; local checkouts for workspace development — valid from the MAIN checkout
  ;; (orgs/etzhayyim/root/20-actors/kaiyaku/clj → orgs/com-junkawasaki/*);
  ;; inside a .claude/worktrees/* checkout use the git deps (default aliases).
  :dev {:override-deps
        {io.github.com-junkawasaki/langgraph-clj
         {:local/root "../../../../../kotoba-lang/langgraph"}
         io.github.com-junkawasaki/browser-use-clj
         {:local/root "../../../../../kotoba-lang/browser-use"}
         io.github.com-junkawasaki/computer-use-clj
         {:local/root "../../../../../kotoba-lang/computer-use"}}}}}
