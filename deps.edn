{:paths ["src" "test" "data"]
 ;; kaiyaku 解約 cljc port (ADR-2606112201) on the portable-Clojure agent stack:
 ;;   langchain → langgraph → browser-use / computer-use
 ;; All four are zero-third-party-dep .cljc (WASM premise, Datomic-API-first).
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/json {:git/sha "4c55a247b020bfb1c7b5b09f9df8f3fa5601a207"}        ;; 契約(継続課金)の正準 item shape。kaiyaku は vault を開けない —
        ;; kagitaba は crypto/store に依存しない純データモデルなので、
        ;; 復号済み item を受け取るための型だけをここから借りる。
        io.github.kotoba-lang/kagitaba
        {:git/url "https://github.com/kotoba-lang/kagitaba.git"
         :git/sha "91a96218b48757ca988d8467824e766317f2ca11"}
        etzhayyim/tate {:git/url "https://github.com/etzhayyim/com-etzhayyim-tate"
                        :git/sha "658b9f67aaa65d7aad5ffda280ec8feaae7a8bc2"}
        ;; All four coordinates below were renamed on 2026-08-20. Each old
        ;; com-junkawasaki name redirects to a kotoba-lang repository, which is
        ;; why they kept resolving; but tools.deps dedupes by the coordinate
        ;; SYMBOL, so an old name and a new name for one repository are two
        ;; libraries to it, and both land on the classpath at their own shas.
        ;;
        ;; They had to move as a set. Renaming langchain alone was measured
        ;; with `clojure -Stree -M:test` and made things worse: the root pin
        ;; became io.github.kotoba-lang/langchain 7038bb8, and langgraph-clj
        ;; v0.2.0 -- which names the OLD langchain coordinate -- was no longer
        ;; overridden by it, so langchain.* loaded twice, from 7038bb8 and from
        ;; v0.1.0. langgraph, browser-use and computer-use all name langchain
        ;; canonically on their current mains, so advancing all four together
        ;; is what actually leaves one langchain in the closure.
        ;;
        ;; Each sha advance is a fast-forward, verified with
        ;; `git merge-base --is-ancestor` against a full (non-shallow) clone:
        ;; langgraph 133740f -> 1ea8ada, browser-use 119cd2f -> 3e0041b,
        ;; computer-use 75b777a -> 172f57a. The tags are dropped because no
        ;; tag on the renamed repositories names these revisions.
        io.github.kotoba-lang/langgraph
        {:git/sha "1ea8adac456647623a4d90af0d33ca5803c681ba"}
        ;; Root authority over langgraph's transitive pin, kept explicit
        ;; because this repo requires langchain namespaces directly. The sha
        ;; moves 7038bb8 -> 52bca7b to MATCH what langgraph 1ea8ada pins, so
        ;; the two agree and no root override is silently downgrading the
        ;; library. 7038bb8 ("bridge repository EDN for foreign runtimes",
        ;; the revision the old comment here was protecting) is an ancestor
        ;; of 52bca7b, so the persistence host this actor deploys against is
        ;; still present.
        io.github.kotoba-lang/langchain
        {:git/sha "52bca7b5b621f48d29e693f642d348d2962bb14e"}
        io.github.kotoba-lang/browser-use
        {:git/sha "3e0041b333675e1716628864ff14b5129d942410"}
        io.github.kotoba-lang/computer-use
        {:git/sha "172f57aa553200b042c0015e960a60e72c812fe4"}}
 :aliases
 {:repository {:main-opts ["-m" "kaiyaku.repository-runtime"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; Local checkouts for workspace development. Paths are relative to THIS
  ;; repo's west path (orgs/etzhayyim/actor-kaiyaku), so `../../` is
  ;; `orgs/`. They were `../../../../../` until 2026-07-30 — correct for the
  ;; pre-extraction location (etzhayyim/root/20-actors/kaiyaku/clj) and wrong
  ;; ever since, which `scripts/west-orphan-audit.cljs --blocking` reported as
  ;; three of its six local-root-broken entries.
  ;;
  ;; The base :deps above are git coordinates and resolve on their own, so only
  ;; this dev alias was affected. Outside the west layout (a worktree in /tmp)
  ;; the relative paths cannot resolve at all — use the default aliases there.
  :dev {:override-deps
        {io.github.kotoba-lang/langgraph
         {:local/root "../../kotoba-lang/langgraph"}
         io.github.kotoba-lang/browser-use
         {:local/root "../../kotoba-lang/browser-use"}
         io.github.kotoba-lang/computer-use
         {:local/root "../../kotoba-lang/computer-use"}}}}}
